[Unit]
Description=Nyx Share service
Documentation=https://github.com/design-nexus/nyx-share

# Started by D-Bus activation when an app shares; exits after a minute idle.
[Service]
Type=dbus
BusName=io.github.design_nexus.nyx.Share1
ExecStart=%h/.local/bin/nyx-share-daemon
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
